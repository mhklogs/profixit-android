{
  "expo": {
    "name": "ProFixit",
    "slug": "profixit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "profixit",
    "newArchEnabled": true,
    "experiments": {
      "tsconfigPaths": true
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.profixit.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF9F7"
      },
      "package": "com.profixit.app",
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      [
        "expo-camera",
        { "cameraPermission": "Allow ProFixit to access your camera for job photos." }
      ],
      [
        "expo-location",
        { "locationWhenInUsePermission": "Allow ProFixit to use your location for nearby job matching." }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Allow ProFixit to access your photos to upload job images." }
      ]
    ]
  }
}